# Local dev port (set if the default 5000 conflicts with another project)
PORT=5000

EMAIL_USER=your-gmail-address@gmail.com
EMAIL_PASS=your-gmail-app-password

MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/portfolioDB

# Admin dashboard auth
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD_HASH=run "npm run hash-password" to generate this
JWT_SECRET=a-long-random-string
JWT_EXPIRES_IN=7d

# Cloudinary (create a free account at cloudinary.com)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
